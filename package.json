    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
