{
  "name": "cvforge-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/desktop/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "electron .",
    "setup:electron": "install-electron",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:f1": "npm test --prefix spikes/f1",
    "test:f4": "npm run build && node --test dist/tests/editor.test.js dist/tests/editor-rich.test.js",
    "test:f4:ui": "playwright test --config playwright.config.ts f4.spec.ts",
    "validate:f4:offline": "node scripts/f4-offline-check.mjs",
    "test:f2": "npm run build && node --test dist/tests/domain.test.js dist/tests/language-revisions.test.js dist/tests/invariants.test.js dist/tests/migrations.test.js dist/tests/portable.test.js",
    "test:f3": "npm run build && node --test dist/tests/sqlite-storage.test.js dist/tests/sqlite-migrations.test.js dist/tests/library.test.js dist/tests/drafts.test.js dist/tests/local-host.test.js dist/tests/storage-failures.test.js dist/tests/project-files.test.js",
    "validate:f3:electron": "npm run build && node scripts/f3-electron-check.mjs",
    "test:f5": "npm run build && node --test dist/tests/f5-*.test.js",
    "test:f5:ui": "playwright test --config playwright.config.ts f5.spec.ts",
    "validate:f5:offline": "node scripts/f5-offline-check.mjs",
    "test:f6": "npm run build && node --test dist/tests/f6-*.test.js",
    "test:f6:ui": "playwright test --config playwright.config.ts f6.spec.ts",
    "validate:f6:offline": "node scripts/f6-offline-check.mjs",
    "test:f7": "npm run build && node --test dist/tests/f7-*.test.js",
    "test:f7:ui": "playwright test --config playwright.config.ts f7.spec.ts",
    "validate:f7:render": "node scripts/f7-render-check.mjs",
    "package:linux": "npm run build && electron-builder --linux --dir --config electron-builder.yml",
    "validate:f7:offline": "node scripts/f7-offline-check.mjs",
    "validate:f7:pdf": "node scripts/f7-render-check.mjs && node scripts/f7-inspect-pdfs.mjs",
    "validate:f7:package": "node scripts/f7-package-check.mjs",
    "validate:f7:reader": "node scripts/f7-external-reader.mjs",
    "test:f8": "npm run build && node --test dist/tests/f8-*.test.js",
    "test:f8:ui": "playwright test --config playwright.config.ts f8.spec.ts",
    "validate:f8:pdf": "node scripts/f8-render-check.mjs && node scripts/f8-inspect-pdfs.mjs",
    "validate:f8:reader": "node scripts/f8-external-reader.mjs",
    "validate:f8:offline": "node scripts/f8-offline-check.mjs",
    "validate:f8:package": "node scripts/f8-package-check.mjs",
    "package:appimage": "node scripts/package-appimage.mjs",
    "test:f9": "npm run build && node --test dist/tests/f9-*.test.js",
    "test:f9:ui": "playwright test --config playwright.config.ts f9.spec.ts f9-blockers.spec.ts",
    "validate:f9:performance": "node scripts/f9-performance.mjs",
    "validate:f9:offline": "node scripts/f9-offline-check.mjs",
    "validate:f9:package": "node scripts/f9-package-check.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "better-sqlite3@13.0.3": true
  },
  "description": "CVForge — local CV editor",
  "author": "CVForge contributors"
}
